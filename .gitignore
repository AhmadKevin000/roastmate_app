# Root .gitignore
#
# Project Flutter sebenarnya ada di dalam folder `mobile/` dan punya
# .gitignore-nya sendiri. File ini mencegah artefak yang di-generate
# ulang di root (mis. kalau `flutter create` / IDE dijalankan dari sini)
# muncul sebagai untracked di `git status`.

# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Platform scaffolding (kalau ke-generate ulang di root)
/android/
/ios/
/macos/
/linux/
/windows/
/web/

# OS
.DS_Store
Thumbs.db

# ML artifacts (detail lengkap ada di ml/.gitignore)
/ml/data/
/ml/runs/
/ml/models/
/ml/**/*.pt
/ml/**/*.onnx
/ml/**/*.tflite

# AI coding agent instructions
# Dibagikan manual ke anggota tim (bukan lewat git), jadi tidak di-push.
/AGENTS.md
/OPENCODE.md
/.cursor/
/.github/copilot-instructions.md
